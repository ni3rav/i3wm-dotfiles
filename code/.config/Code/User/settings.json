{
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
  },
  "explorer.confirmDelete": false,
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off",
  },
  "git.openRepositoryInParentFolders": "always",
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "emmet.triggerExpansionOnTab": true,
  "workbench.settings.applyToAllProfiles": [
    "editor.fontFamily",
    "terminal.integrated.fontFamily",
  ],
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.indent": 10,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "zenMode.showTabs": "none",
  "editor.linkedEditing": true,
  "keyboard.dispatch": "keyCode",
  "fiveServer.browser": ["brave"],
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "tailwindCSS.emmetCompletions": true,
  "editor.accessibilitySupport": "off",
  "screencastMode.verticalOffset": 2,
  "workbench.editor.enablePreview": false,
  "files.autoSave": "afterDelay",
  "screencastMode.keyboardOptions": {
    "showKeybindings": false,
  },
  "editor.matchBrackets": "never",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "fiveServer.port": 3003,
  "material-icon-theme.folders.theme": "specific",
  "editor.guides.bracketPairs": false,
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "git.autofetch": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "security.workspace.trust.untrustedFiles": "open",
  "[mdx]": {
    "editor.defaultFormatter": "unifiedjs.vscode-mdx",
  },
  "workbench.editor.editorActionsLocation": "hidden",
  "mdx.trace.server.format": "json",
  "mdx.trace.server.verbosity": "messages",
  "mdx.server.enable": true,
  "editor.lineNumbers": "relative",
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,
  "explorer.decorations.badges": false,
  "editor.wordWrap": "on",
  "reactSnippets.settings.importReactOnTop": false,
  "editor.find.cursorMoveOnType": false,
  "emmet.includeLanguages": {
    "njk": "html",
    "javascript": "javascriptreact",
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.inlayHints.fontFamily": "CommitMonoDef",
  "workbench.startupEditor": "none",
  "window.customTitleBarVisibility": "auto",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "workbench.productIconTheme": "bongocat",
  "editor.semanticHighlighting.enabled": true,
  "editor.stickyScroll.enabled": false,
  "workbench.navigationControl.enabled": false,
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.minimap.size": "fit",
  "workbench.sideBar.location": "right",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "editor.guides.indentation": false,
  "editor.cursorStyle": "line",
  "extensions.ignoreRecommendations": true,
  "vim.handleKeys": {
    "<C-f>": false,
    "<C-h>": false,
    "<C-c>": false,
    "<C-v>": false,
    "<C-x>": false,
    "<C-d>": false,
    "<C-j>": false,
    "<C-p>": false,
    "<C-w>": false,
    "<C-k>": false,
  },
  "vim.useSystemClipboard": true,
  "better-comments.highlightPlainText": true,
  "editor.formatOnSave": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "chat.commandCenter.enabled": false,
  "breadcrumbs.enabled": false,
  "files.associations": {
    "*.py": "python",
  },
  "workbench.colorCustomizations": {},
  "editor.minimap.enabled": false,
  "chat.mcp.gallery.enabled": true,
  "roo-cline.allowedCommands": ["git log", "git diff", "git show"],
  "roo-cline.deniedCommands": [],
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "workbench.layoutControl.enabled": false,
  "editor.lineHeight": 1.5,
  "editor.fontFamily": "JetBrainsMono Nerd Font, Bold",
  "editor.fontLigatures": "'calt','ss01'",
  "window.zoomLevel": 1.5,
  "@azure.argTenant": "",
  "workbench.editor.empty.hint": "hidden",
  "chat.agentsControl.enabled": false,
  "workbench.colorTheme": "Tokyo Night",
  "chat.viewSessions.orientation": "stacked",
  "window.autoDetectColorScheme": true,
  "workbench.iconTheme": "bearded-icons",
  "azureFunctions.showProjectWarning": false,
  "[go]": {
    "editor.defaultFormatter": "golang.go",
  },
  "workbench.browser.showInTitleBar": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.activityBar.location": "top",
  "go.toolsManagement.autoUpdate": true,
  "python.analysis.typeCheckingMode": "standard",
  "network.meteredConnection": "off",
  "workbench.preferredDarkColorTheme": "Tokyo Night",
  "window.menuBarVisibility": "compact",
}
