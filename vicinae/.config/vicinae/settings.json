{
	"$schema": "https://vicinae.com/schemas/config.json",
	"pop_to_root_on_close": true,
	"search_files_in_root": false,
	"favorites": [
		"clipboard:history",
		"files:search",
		"core:search-emojis",
		"wm:switch-windows"
	],
	"fallbacks": [
		"files:search"
	],
	"font": {
		"rendering": "native",
		"normal": {
			"family": "JetBrainsMono Nerd Font",
			"size": 12
		}
	},
	"theme": {
		"dark": {
			"name": "tokyo-night",
			"icon_theme": "Tela-circle-dark"
		},
		"light": {
			"name": "vicinae-light",
			"icon_theme": "Tela-circle-dark"
		}
	},
	"launcher_window": {
		"opacity": 0.9,
		"material": "blur",
		"blur": {
			"enabled": true
		},
		"client_side_decorations": {
			"enabled": false
		},
		"compact_mode": {
			"enabled": false
		}
	}
}
